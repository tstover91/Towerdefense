; Minimal project configuration for the grid-maze gameplay prototype.

config_version=5

[application]

config/name="Grid Maze Prototype"
config/description="A landscape grid-based tower-defense maze prototype."
config/version="0.1.0"
run/main_scene="res://prototype/prototype_mode_select.tscn"
config/features=PackedStringArray("4.7", "Mobile")

[display]

window/size/viewport_width=1152
window/size/viewport_height=648
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[input_devices]

pointing/emulate_mouse_from_touch=false

[rendering]

renderer/rendering_method="mobile"
textures/vram_compression/import_etc2_astc=true
